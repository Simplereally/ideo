    <style>
        :root {
            --bg: #f9fafb;
            --fg: #111827;
            --accent: #10b981;
            --accent-hover: #059669;
            --border: rgba(0, 0, 0, 0.08);
            --card: #ffffff;
            --muted: #6b7280;
            --shimmer: linear-gradient(90deg, transparent, rgba(16, 185, 129, 0.05), transparent);
        }

        @media (prefers-color-scheme: dark) {
            :root {
                --bg: #09090b;
                --fg: #f9fafb;
                --accent: #10b981;
                --accent-hover: #34d399;
                --border: rgba(255, 255, 255, 0.1);
                --card: #111114;
                --muted: #a1a1aa;
                --shimmer: linear-gradient(90deg, transparent, rgba(16, 185, 129, 0.1), transparent);
            }
        }

        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg);
            color: var(--fg);
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            line-height: 1.5;
            opacity: 0;
            transition: opacity 0.2s ease-in;
        }
        body.loaded { opacity: 1; }

        header {
            width: 100%;
            max-width: 42rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 2rem 1.5rem;
            position: relative;
        }

        .logo-wrap { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: inherit; }
        .logo-svg { width: 2.25rem; height: 2.25rem; fill: currentColor; color: var(--accent); }
        .logo-text { font-weight: 800; font-size: 1.25rem; letter-spacing: -0.025em; }

        nav { display: flex; gap: 0.5rem; }
        .nav-link {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--muted);
            padding: 1rem 1.25rem;
            text-decoration: none;
            transition: color 0.2s;
            position: relative;
            display: inline-flex;
            align-items: center;
        }
        .nav-link::after {
            content: '';
            position: absolute;
            inset: -5px;
        }
        .nav-link:hover { color: var(--accent); }

        .nav-toggle {
            display: none;
            background: none;
            border: 1px solid var(--border);
            color: var(--fg);
            padding: 0.5rem;
            border-radius: 0.5rem;
            cursor: pointer;
        }

        #mobile-nav {
            display: none;
            position: absolute;
            top: 100%;
            left: 1rem;
            right: 1rem;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 1rem;
            padding: 1rem;
            z-index: 50;
            flex-direction: column;
            box-shadow: 0 20px 25px -5px rgba(0,0,0,0.2);
        }
        #mobile-nav.open { display: flex; }
        @media (max-width: 640px) {
            header nav { display: none; }
            .nav-toggle { display: block; }
        }

        main {
            width: 100%;
            max-width: 42rem;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 2.5rem;
        }

        .card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 1.5rem;
            overflow: hidden;
            box-shadow: 0 10px 30px -10px rgba(0,0,0,0.1);
        }

        .card-content { padding: 2.5rem; display: flex; flex-direction: column; gap: 1.5rem; }
        .card-content h2 { margin: 0; font-size: 1.5rem; font-weight: 800; letter-spacing: -0.025em; }
        .card-content h3 { font-size: 1.1rem; font-weight: 700; margin-top: 1rem; margin-bottom: 0.25rem; color: var(--accent); }
        .card-content h4 { font-size: 1rem; font-weight: 700; margin-top: 0.75rem; margin-bottom: 0.25rem; color: var(--fg); }
        .card-content p { color: var(--fg); opacity: 0.9; line-height: 1.6; margin: 0; }
        .card-content strong { color: var(--fg); font-weight: 700; }
        .card-content a { color: var(--accent); text-decoration: none; font-weight: 600; }
        .card-content a:hover { text-decoration: underline; }

        .primary-btn {
            background: var(--accent);
            color: #fff !important;
            padding: 0.875rem 2rem;
            border-radius: 1rem;
            border: none;
            font-weight: 800;
            font-size: 0.8rem;
            text-transform: uppercase;
            cursor: pointer;
            transition: background 0.2s;
            position: relative;
            min-height: 3rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .primary-btn:hover { background: var(--accent-hover); }

        .secondary-btn {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 1rem;
            padding: 0.875rem 2rem;
            color: var(--fg);
            font-weight: 800;
            font-size: 0.8rem;
            text-transform: uppercase;
            cursor: pointer;
            transition: background 0.2s;
            min-height: 3rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .secondary-btn:hover { background: var(--bg); }

        .badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            background: rgba(16, 185, 129, 0.1);
            color: var(--accent);
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 700;
        }

        footer {
            margin-top: auto;
            padding: 5rem 1.5rem 2.5rem 1.5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.5rem;
            width: 100%;
            max-width: 42rem;
        }
        .footer-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; }
        .footer-links a { font-size: 0.65rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); text-decoration: none; padding: 1rem; display: inline-block; }
        .social-links { display: flex; flex-wrap: wrap; justify-content: center; margin-top: -2rem;}
        .social-links a { font-size: 0.65rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); text-decoration: none; padding: 0.5rem 1rem; }
        .stats { font-size: 0.65rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.2em; color: var(--accent); text-align: center; opacity: 0.8; line-height: 1.5; margin-top: -1.5rem; }
    </style>
</head>
